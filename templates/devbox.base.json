{
  "version": 2,
  "mode": "scaffold",
  "services": [
    {
      "name": "my-app",
      "source": "src/my-app",
      "workdir": "/app",
      "context": "src/my-app",
      "dockerfile": "Dockerfile",
      "target": "dev",
      "port": 5173,
      "runtime": "node",
      "managed": true
    }
  ],
  "inject_ide": false,
  "compose_files": [
    "docker-compose.yml",
    "docker-compose.dev.yml",
    "build/docker-compose.mcp.yml"
  ],
  "mcp": {
    "protected_services": [],
    "exec": {
      "default_timeout": 180,
      "max_timeout": 3600,
      "max_output_kb": 64
    },
    "processes": {
      "max_per_container": 5,
      "max_log_mb": 10
    }
  }
}
