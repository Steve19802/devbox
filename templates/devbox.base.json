{
  "version": 1,
  "service": "my-app",
  "dockerfile": "Dockerfile",
  "dockerfile_context": ".",
  "port": 5173,
  "stages": {
    "prod": "prod",
    "dev": "dev"
  },
  "inject_ide": false,
  "has_firebase": false,
  "preserve_env": [],
  "compose_files": [
    "docker-compose.yml",
    "docker-compose.dev.yml",
    "build/docker-compose.mcp.yml"
  ],
  "mcp": {
    "protected_services": [],
    "exec": {
      "default_timeout": 180,
      "max_timeout": 3600,
      "max_output_kb": 64
    },
    "processes": {
      "max_per_container": 5,
      "max_log_mb": 10
    }
  }
}
